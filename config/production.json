{
  "server": {
    "port": 8080,
    "host": "0.0.0.0",
    "cors": {
      "enabled": true,
      "origins": ["https://yourdomain.com"]
    }
  },
  "database": {
    "name": "hidog_prod",
    "ssl": true,
    "pool": {
      "min": 5,
      "max": 20
    }
  },
  "logging": {
    "level": "warn",
    "console": false,
    "file": "/var/log/hidog/hidog.log"
  },
  "cache": {
    "type": "redis",
    "host": "redis.yourdomain.com",
    "port": 6379,
    "password": "${REDIS_PASSWORD}",
    "ttl": 7200
  },
  "security": {
    "jwt": {
      "secret": "${JWT_SECRET}",
      "expiresIn": "2h"
    },
    "rateLimit": {
      "windowMs": 900000,
      "max": 50
    }
  },
  "production": {
    "compression": true,
    "clustering": true,
    "monitoring": {
      "enabled": true,
      "endpoint": "https://monitoring.yourdomain.com"
    }
  }
}