{
  "name": "hidog",
  "version": "1.0.0",
  "description": "一个友好的项目，用于...",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm run clean && npm run compile",
    "clean": "rm -rf dist/",
    "compile": "babel src -d dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "prepare": "husky install"
  },
  "keywords": [
    "hidog",
    "node",
    "javascript",
    "api"
  ],
  "author": "peacezha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peacezha/hidog.git"
  },
  "bugs": {
    "url": "https://github.com/peacezha/hidog/issues"
  },
  "homepage": "https://github.com/peacezha/hidog#readme",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "eslint": "^8.44.0",
    "prettier": "^3.0.0",
    "jest": "^29.6.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ]
  }
}